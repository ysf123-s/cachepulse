# 本机一键启停脚本读取的环境变量。复制为 cachepulse-local.env（已被 .gitignore 忽略）后填写，不要提交。
# 每行 KEY=VALUE，# 开头是注释。脚本只把这些值传给子进程，不打印。

# --- 中间件（经 SSH 隧道访问 Instabox 时都是 127.0.0.1）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=demo
MYSQL_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
# Kafka 对外通告 localhost:9092，本地转发端口必须也是 9092
KAFKA_BOOTSTRAP=127.0.0.1:9092
# 切换时要和原项目一致（设计文档第 11 节）
PLATFORM_SOURCE_ID=local-mysql-v1

# --- Nacos 3.0.3（本机单机模式，鉴权开启）---
# 解压官方 nacos-server-3.0.3.zip 后的目录；为空时脚本不启动 Nacos，只连接 NACOS_ADDR
NACOS_HOME=
NACOS_ADDR=127.0.0.1:18848
NACOS_USERNAME=nacos
NACOS_PASSWORD=
# Base64，原文至少 32 字节：[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
NACOS_TOKEN_SECRET=
NACOS_IDENTITY_KEY=cachepulse
NACOS_IDENTITY_VALUE=

# --- 服务之间 ---
# /internal/** 的共享令牌，所有服务用同一个值
CACHEPULSE_INTERNAL_TOKEN=

# --- 网关 ---
GATEWAY_ADMIN_USER=admin
# BCrypt 哈希，生成方法见 README「网关登录」
GATEWAY_ADMIN_PASSWORD_HASH=
# Base64，原文至少 32 字节
GATEWAY_JWT_SECRET=
# 本机直接访问网关，没有反向代理
GATEWAY_TRUSTED_PROXIES=0
# 前面的反向代理写入客户端 IP 的请求头（Instabox 上是 X-CachePulse-Client-IP，由华为云 Nginx 写入）；本机留空
GATEWAY_CLIENT_IP_HEADER=

# 开发期间本机不写心跳（设计文档第 6.5 节），只在 Instabox 上改为 true
CDC_HEARTBEAT_ENABLED=false
