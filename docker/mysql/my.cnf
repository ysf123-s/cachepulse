# Canal 依赖的 MySQL 配置：ROW 格式 + FULL 行镜像，否则拿不到完整行数据。
[mysqld]
server-id=1
log-bin=mysql-bin
binlog-format=ROW
binlog-row-image=FULL
# 保留 3 天。演示机硬盘小，一次 75 秒的高负载压测会写出约 1 GB binlog；Instabox 上已同样改为 3 天。
binlog-expire-logs-seconds=259200

# 保证 binlog 位点在重启后连续，避免 Canal 解析到不存在的文件。
max-binlog-size=512M
sync-binlog=1

character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
